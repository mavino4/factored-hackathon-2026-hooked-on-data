  "cards": [
    {
      "dot": "emerald",
      "title": "One agent, classified first",
      "items": [
        "Every message is classified: account, general, out_of_scope or human",
        "Only account questions get the tool definitions",
        "If the classifier fails, the full agent with tools answers"
      ]
    },
    {
      "dot": "violet",
      "title": "Human in the loop",
      "items": [
        "Asking for a person opens a handoff; the bot stops answering",
        "Insistence offers an advisor (Yes / No); no new offer for 3 turns after No",
        "Advisors reply and close through the operator API; replies carry author=operator"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy in traces",
      "items": [
        "One span per graph step, with its model calls and tools nested under it",
        "Name, city, last 4, amounts and document numbers become placeholders",
        "User ID sent as a keyed hash; AIP_TRACE_HASH_KEY required in production"
      ]
    }
  ]
