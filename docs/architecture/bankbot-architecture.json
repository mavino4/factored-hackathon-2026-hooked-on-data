  "cards": [
    { "dot": "rose", "title": "Security", "items": [
      "Every /v1 call needs a Bearer JWT verified against the issuer's JWKS; dev header mode is refused in production",
      "Bank DB access (bank tools and the /v1/me greeting name) sets app.subject to the token sub; Postgres RLS hides every other customer",
      "The agent SSE stream shows tool progress only: no tool arguments or raw results reach the customer",
      "Irreversible tools become pending actions and run only after the user approves"
    ] },
    { "dot": "violet", "title": "Reply language", "items": [
      "The UI sends its language (es / pt / en) with every chat, agent, regenerate and approval request",
      "It reaches the model as a separate system block after the cached prompt, so the prompt-cache prefix is unchanged"
    ] },
    { "dot": "cyan", "title": "Persistence", "items": [
      "ChatService and AgentRunner append messages through the conversation repository built by the API",
      "usage_events feed the daily token quota and GET /v1/admin/usage",
      "Without AIP_DATABASE_URL, storage falls back to in-memory (dev only)"
    ] },
    { "dot": "slate", "title": "Not shown", "items": [
      "Prometheus metrics on AIP_METRICS_PORT (default 9090)",
      "Alembic migrate job, evals/ harness, and the dev OIDC issuer script"
    ] }
  ]
