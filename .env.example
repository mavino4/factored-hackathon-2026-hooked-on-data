# Copy to .env. Credentials for the Claude API come from ANTHROPIC_API_KEY
# (or an `ant auth login` profile).
ANTHROPIC_API_KEY=

# Provider failover order: JSON list of anthropic | bedrock | vertex | ollama
AIP_PROVIDERS=["anthropic"]
# Local Ollama (no API key needed): AIP_PROVIDERS=["ollama"]
# AIP_OLLAMA_BASE_URL=http://localhost:11434
# AIP_OLLAMA_MODEL=llama3.2:3b
# AIP_AWS_REGION=us-east-1
# AIP_GCP_PROJECT_ID=my-project
# AIP_GCP_REGION=global

AIP_USER_REQUESTS_PER_MINUTE=20
AIP_USER_TOKENS_PER_DAY=500000
AIP_LOG_LEVEL=INFO

# External core-banking DB (read-only role, Row-Level Security). Load it with `make bank-db`.
# Unset = the agent has no banking tools.
# AIP_BANK_DATABASE_URL=postgresql+asyncpg://bank_reader:bank_reader@localhost:5432/bank

# Storage. Unset = in-memory (dev only). docker compose sets this for you.
# AIP_DATABASE_URL=postgresql+asyncpg://aiplatform:aiplatform@localhost:5432/aiplatform
AIP_ENV=dev

# Observability: Prometheus metrics on a separate internal port (0 = off).
AIP_METRICS_PORT=9090
# Tracing to the self-hosted Langfuse (`make langfuse-env && make langfuse-up`). Off by default.
# Customer data is masked before sending (src/aiplatform/privacy.py).
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Version of the code in the traces (make lan sets it to the git commit).
# AIP_RELEASE=
# OpenAI key: only for the intent classifier bench (evals/classify_bench.py,
# text-embedding-3-small). Read from this file by Settings, like ANTHROPIC_API_KEY.
# OPENAI_API_KEY=sk-...
# TypeSafe AI key, for Jev (https://console.typesafe.ai/).
# TYPESAFE_API_KEY=
# Intent classifier: llm | jev_llm (Jev first on the masked transcript; the LLM decides
# below AIP_JEV_THRESHOLD or if Jev fails). The LAN demo (make prod) defaults to jev_llm.
# AIP_INTENT_CLASSIFIER=llm
# AIP_JEV_THRESHOLD=0.9
# Quick-action buttons: model (classified like any message) | intent (the button gives
# the intent, no classifier; the model answers) | direct (no model: a fixed text filled
# with the customer's products). Traces carry it as metadata "routing".
# AIP_QUICK_ACTIONS=model
# AIP_TRACE_HASH_KEY=          # openssl rand -hex 32 (required in production; random per process in dev)
# AIP_TRACE_MASK_AMOUNTS=false # dev only: show balances and amounts in traces
# Users allowed to read GET /v1/admin/usage (token sub, or X-User-Id in dev mode).
AIP_ADMIN_USERS=[]

# Auth. Local development: dev mode trusts the X-User-Id header (refused when AIP_ENV=production).
AIP_AUTH_MODE=dev
# Username + password accounts kept by the app (create them with `make users`):
# AIP_AUTH_MODE=password
# AIP_SESSION_COOKIE_SECURE=true   # when served over HTTPS (always on in production)
# Real login (any OIDC provider, e.g. Auth0):
# AIP_AUTH_MODE=oidc
# AIP_OIDC_ISSUER=https://your-tenant.eu.auth0.com/
# AIP_OIDC_AUDIENCE=https://api.your-app.example
# AIP_OIDC_CLIENT_ID=your-spa-client-id   # web UI login (Single Page Application)
