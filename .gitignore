# --- Secrets -------------------------------------------------------------
# Real env files and keys never go in git; the *.example templates do.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
# Real k8s Secrets (secret.example.yaml is the committed template)
deploy/**/secret.yaml
deploy/**/*.secret.yaml
deploy/**/secrets/
# Dev OIDC issuer signing key (scripts/dev_oidc.py)
.dev-oidc/

# --- Python / uv ---------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Tooling caches & reports --------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
# Playwright (scripts/e2e_ui.py) failure artifacts
test-results/
playwright-report/

# --- Generated diagrams (Archify) ----------------------------------------
.archify/

# --- Editors / OS --------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Claude Code personal settings ---------------------------------------
.claude/settings.local.json
